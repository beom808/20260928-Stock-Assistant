# ── 복사해서 backend/.env 로 사용. 실제 키는 절대 커밋하지 말 것 ──
DATABASE_URL=sqlite:///./stock_assistant.db
# 운영: postgresql+psycopg://user:pass@host:5432/dbname (Supabase 등)

# 스케줄러(Cloud Scheduler 등)가 POST /jobs/{type}/run 호출 시 사용할 공유 토큰
JOB_TRIGGER_TOKEN=change-me

# 뉴스 / 실적캘린더 (Finnhub) — 무료 한도 60 req/min 으로 조사됨. 연동 전 재확인 필요
FINNHUB_API_KEY=
FINNHUB_RATE_PER_MIN=50

# 경제캘린더 / 지수 (Financial Modeling Prep) — 무료 한도 250 req/day 로 조사됨.
# economic-calendar / earnings-calendar 는 유료 플랜 전용일 수 있음 → 반드시 재확인
FMP_API_KEY=
FMP_DAILY_LIMIT=240
# FMP 경제캘린더 date 필드의 타임존 (공식 문서 확인 필요). 앱이 CPI 08:30 ET 로 자동 검증함
FMP_ECON_CALENDAR_TZ=UTC

# 키움증권 REST API (국내 지수, 설정 시 KIS 보다 우선) — openapi.kiwoom.com 에서 사용 신청·발급
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_BASE_URL=https://api.kiwoom.com
# 키움 허용 IP 대응: 고정 IP 프록시 주소(Fixie 등, 비밀번호 포함). 키움 요청에만 사용
KIWOOM_PROXY_URL=

# 한국투자증권 KIS Developers (실전 도메인) — 키움 대안
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 네이버 검색 API (국내 당일 이슈용, 선택)
# 신규 키는 네이버 클라우드 플랫폼 NAVER API HUB 에서 발급(Client ID / Client Secret).
# 기존 개발자센터(developers.naver.com) 키라면 NAVER_API=legacy
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API=hub

# Anthropic Claude API (없으면 규칙기반 fallback 으로 동작)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Firebase Cloud Messaging HTTP v1 (선택)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# 또는 서비스 계정 키 JSON 내용 전체 (GitHub Secret 용)
FCM_SERVICE_ACCOUNT_JSON=
# 알림 클릭 시 열 사이트 주소
SITE_URL=https://stockassistant2.netlify.app

# CORS 허용 오리진 (콤마 구분)
CORS_ORIGINS=http://localhost:3000
